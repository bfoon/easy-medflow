DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=medflow
POSTGRES_USER=medflow
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
# Clinical AI (off by default). Only de-identified data is sent, from the server.
CLINICAL_AI_ENABLED=False
# anthropic (Claude API) or endpoint (your own approved service). Blank = anthropic when ANTHROPIC_API_KEY is set.
CLINICAL_AI_PROVIDER=
ANTHROPIC_API_KEY=
CLINICAL_AI_MODEL=claude-sonnet-5-5
# Let the AI search trusted medical sites (MEDICAL_TRUSTED_DOMAINS). Set False on an intranet without internet.
CLINICAL_AI_WEB_SEARCH=True
CLINICAL_AI_ENDPOINT=
CLINICAL_AI_TOKEN=
# Lab result guidance from WHO, MedlinePlus and PubMed, fetched in the background (no patient data is sent).
MEDICAL_EVIDENCE_FETCH=True
MEDICAL_EVIDENCE_MAX_AGE_DAYS=30
# MEDICAL_TRUSTED_DOMAINS=who.int,nih.gov,medlineplus.gov,cdc.gov,nice.org.uk,msf.org,cochranelibrary.com,bmj.com,thelancet.com,nejm.org
NCBI_EMAIL=
# NCBI_API_KEY=
# Map tiles (optional). Without these, maps use Esri street/satellite and OpenStreetMap (no key needed).
# MAPTILER_KEY=your-free-key-from-maptiler.com
# MAP_TILE_URL=https://your.tile.server/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; Your provider
# Email notifications (optional). Without these, development prints emails to the log.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=notifications@example.com
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=E-MedFlow <notifications@example.com>
# SITE_URL=https://emedflow.example.com

# Ambulance service
# EMS_HOSPITAL_LAT=13.4440
# EMS_HOSPITAL_LON=-16.6790
# EMS_ROUTER_URL=https://router.project-osrm.org   # your own OSRM server for turn-by-turn directions; blank = straight-line guidance
# EMS_APP_KEYS=change-me-long-random-key            # the phone app sends this in the X-App-Key header
# EMS_SIMULATION=False
